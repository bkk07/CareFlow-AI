# Copy to `.env` (same directory) for local runs. Never commit `.env`.
ENVIRONMENT=local

# Backend -> Postgres (docker-compose service name; local override uses localhost)
DATABASE_URL=postgresql+psycopg2://careflow:careflow@localhost:5432/careflow
POSTGRES_USER=careflow
POSTGRES_PASSWORD=careflow
POSTGRES_DB=careflow

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
LLM_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
