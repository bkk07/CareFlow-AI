# Copy to `.env` (same directory) for local runs. Never commit `.env`.
ENVIRONMENT=local

# Backend -> Postgres (docker-compose service name; local override uses localhost)
DATABASE_URL=postgresql+psycopg2://careflow:careflow@localhost:5432/careflow
POSTGRES_USER=careflow
POSTGRES_PASSWORD=careflow
POSTGRES_DB=careflow

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=https://api.groq.com/openai/v1
AI_CONTEXT_TTL_S=7200

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
VITE_API_URL=http://localhost:8000

EHR_MOCK_BASE_URL=http://localhost:8000
EHR_HTTP_TIMEOUT_S=10
