GROQ_API_KEY=

# --- Railway single-container deploy (service root = backend/) ---
# DATABASE_URL comes from a Railway Postgres plugin, e.g.:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
# The entrypoint accepts postgres://, postgresql:// and
# postgresql+psycopg2:// spellings.
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# REDIS_URL: omit to use the embedded redis, or reference Railway Redis:
#   REDIS_URL=${{Redis.REDIS_URL}}
# REDIS_URL=
#
# JWT_SECRET must be set to a long random string in production.
# JWT_SECRET=
# Comma-separated public URLs of your frontends (Vercel, etc.).
# BACKEND_CORS_ORIGINS=https://your-patient-app.vercel.app
# LLM / voice / telephony keys (see infra/.env.example for the full list).
# INCEPTION_API_KEY=
# Voice STT: must be groq for real transcription (stub hears nothing).
# STT_PROVIDER=groq
# STT_MODEL=whisper-large-v3-turbo
# ALL_IN_ONE defaults to true (API + worker + beat in one container).
# Set ALL_IN_ONE=false only for split docker-compose style layouts.